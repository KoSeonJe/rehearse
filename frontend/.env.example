# API Server URL (개발 시 Vite proxy가 처리하므로 빈 값 가능)
VITE_API_URL=

# 환경 구분
VITE_APP_ENV=development

# SEO 베이스 URL (canonical / og:url / sitemap에 사용)
# 환경별 자동 로드: .env.development = dev, .env.production = prod
VITE_SITE_URL=https://rehearse.co.kr

# GA4 측정 ID (G-XXXXXXXXXX 형식, 공개값이라 FE 노출 안전. 미설정 시 분석 비활성)
VITE_GA4_MEASUREMENT_ID=
