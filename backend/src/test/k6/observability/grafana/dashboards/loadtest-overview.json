{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["loadtest"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Rehearse Loadtest Overview",
  "uid": "rehearse-loadtest",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "호스트 CPU 사용률 (node_exporter)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU busy %"
        }
      ]
    },
    {
      "id": 2,
      "title": "JVM Heap (used / committed / max)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"spring-app\",area=\"heap\"})",
          "legendFormat": "heap used"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_committed_bytes{job=\"spring-app\",area=\"heap\"})",
          "legendFormat": "heap committed"
        },
        {
          "refId": "C",
          "expr": "sum(jvm_memory_max_bytes{job=\"spring-app\",area=\"heap\"})",
          "legendFormat": "heap max (-Xmx)"
        }
      ]
    },
    {
      "id": 3,
      "title": "HikariCP 커넥션 (active / idle / pending)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=\"spring-app\"}",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_idle{job=\"spring-app\"}",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_pending{job=\"spring-app\"}",
          "legendFormat": "pending (대기)"
        },
        {
          "refId": "D",
          "expr": "hikaricp_connections_max{job=\"spring-app\"}",
          "legendFormat": "max (pool=10)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Tomcat threads.busy / current",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tomcat_threads_busy_threads{job=\"spring-app\"}",
          "legendFormat": "busy"
        },
        {
          "refId": "B",
          "expr": "tomcat_threads_current_threads{job=\"spring-app\"}",
          "legendFormat": "current"
        },
        {
          "refId": "C",
          "expr": "tomcat_threads_config_max_threads{job=\"spring-app\"}",
          "legendFormat": "config max (200)"
        }
      ]
    },
    {
      "id": 5,
      "title": "http_server_requests p95 / p99 (전체)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring-app\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring-app\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 6,
      "title": "http_server_requests throughput / error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx rate" }, "properties": [ { "id": "unit", "value": "percentunit" } ] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"spring-app\"}[1m]))",
          "legendFormat": "total rps"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"spring-app\",status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"spring-app\"}[1m])), 1)",
          "legendFormat": "5xx rate"
        }
      ]
    }
  ]
}
