# loadtest EC2 프로비저닝 설정 — 복사 후 config.env 로 채워 사용.
#   cp config.env.example config.env  &&  편집  &&  source config.env
# config.env 는 gitignore 대상(키·계정 식별자 포함 가능). 커밋 금지.

# ── 사용자 결정 필요 (미설정 시 스크립트 중단) ──
export AWS_REGION="ap-northeast-2"                 # 서울
export LOADTEST_INSTANCE_TYPE="t4g.small"          # ARM64 Graviton2 / 2 vCPU / 2GB (tech-spec 고정)
export LOADTEST_KEY_NAME=""                        # EC2 키페어 이름 (SSH 접속용) — 사용자 결정
export LOADTEST_SECURITY_GROUP_ID=""               # SG ID (sg-xxxx). 8080/9091/3000 인바운드는 본인 IP 한정 권장 — 사용자 결정
export LOADTEST_SUBNET_ID=""                       # 서브넷 ID (subnet-xxxx) — 사용자 결정 (퍼블릭 서브넷 권장: scp 접근)

# ── AMI: arm64 Amazon Linux 2023 (SSM 파라미터에서 자동 해석, 아래 run-instances 스크립트가 조회) ──
export LOADTEST_AMI_SSM_PARAM="/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64"

# ── 태그 / 식별 ──
export LOADTEST_NAME_TAG="rehearse-loadtest"

# ── 배포 대상 (run-instances 성공 후 출력된 값으로 채움) ──
export LOADTEST_INSTANCE_ID=""                     # i-xxxx (run-instances 후 기록)
export LOADTEST_SSH_USER="ec2-user"                # AL2023 기본 계정
export LOADTEST_SSH_HOST=""                        # 퍼블릭 IP/DNS (start 후 기록)
export LOADTEST_SSH_KEY_PATH=""                    # 로컬 .pem 경로

# ── JVM heap 주입 지점 (tech-spec 베이스라인) ──
export LOADTEST_JAVA_OPTS="-Xmx768m -Xms768m"
